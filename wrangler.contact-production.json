{
  "name": "evc-contact-production-disabled",
  "main": "workers/contact-production.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACT_BUDGET",
        "class_name": "ContactBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-contact-budget",
      "new_sqlite_classes": [
        "ContactBudget"
      ]
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.png"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "CONTACT_ENABLED": "false",
    "CONTACT_INGRESS_POLICY": "unverified",
    "CONTACT_DELIVERY_MODE": "readable-orchestrated",
    "CONTACT_ORIGIN": "https://evolve-vc.vercel.app",
    "CONTACT_TURNSTILE_HOSTNAME": "evolve-vc.vercel.app",
    "CONTACT_TURNSTILE_ACTION": "contact_us",
    "CONTACT_FROM": "onboarding@resend.dev",
    "CONTACT_TO": "evolvevc.2024@gmail.com",
    "CONTACT_READABLE_KID": "evc-readable-b2491e83-771e-4750-af0e-89899fe192e5",
    "CONTACT_READABLE_PUBLIC_JWK": "",
    "CONTACT_PUBLIC_JWK": "",
    "CONTACT_VISITOR_LIMIT": "3",
    "CONTACT_DAILY_LIMIT": "50",
    "CONTACT_MONTHLY_LIMIT": "1500",
    "CONTACT_ENDPOINT": "https://evc-contact-production-disabled.evolvevc-2024.workers.dev/api/contact/"
  }
}
